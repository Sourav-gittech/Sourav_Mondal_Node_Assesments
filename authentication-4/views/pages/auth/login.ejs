<%- include("./../../layout/header") %>

    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card bg-black text-light p-4 shadow" style="width: 380px;">
            <h3 class="text-center text-success mb-3">Login Here</h3>

                    <form action="/auth/login" method="post">
                        <div class="mb-3">
                            <label class="text-dark">Email</label>
                            <input class="form-control bg-dark text-light" type="email" name="email" required>
                        </div>

                        <div class="mb-3">
                            <label class="text-dark">Password</label>
                            <input class="form-control bg-dark text-light" type="password" name="password" required>
                        </div>

                        <button class="btn btn-success w-100">Login</button>
                    </form>
        </div>
    </div>

    <%- include("./../../layout/footer") %>