<!doctype html>
<html lang="en">

<%- include("./../layout/header") %>

    <body>
        <div class="container my-5">

            <h4 class="text-center mb-4">Add Employee</h4>
            <a href="/employee/" class="btn btn-warning mb-3">Home</a>

            <form action="/employee/addDetails" method="post" enctype="multipart/form-data"
                class="border border-dark p-4 rounded">

                <fieldset class="border p-3 mb-4">
                    <legend class="w-auto px-2">Employee Info</legend>

                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" name="name" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Salary</label>
                        <input type="number" class="form-control" name="salary" required>
                    </div>
                </fieldset>

                <fieldset class="border p-3 mb-4">
                    <legend class="w-auto px-2">Contact Details</legend>

                    <!-- Phone + Email -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Phone</label>
                            <input type="text" class="form-control" name="contact[phone]" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" name="contact[email]" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">City</label>
                            <input type="text" class="form-control" name="contact[city]" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input type="text" class="form-control" name="contact[address]" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Full Address</label>
                        <textarea class="form-control" name="contact[full_address]" rows="2" required></textarea>
                    </div>
                </fieldset>

                <fieldset class="border p-3 mb-4">
                    <legend class="w-auto px-2">Department</legend>

                    <div class="row">
                        <div class="col-md-3 form-check">
                            <input class="form-check-input" type="checkbox" name="department[department_name][]"
                                value="HR">
                            <label class="form-check-label">HR</label>
                        </div>

                        <div class="col-md-3 form-check">
                            <input class="form-check-input" type="checkbox" name="department[department_name][]"
                                value="IT">
                            <label class="form-check-label">IT</label>
                        </div>

                        <div class="col-md-3 form-check">
                            <input class="form-check-input" type="checkbox" name="department[department_name][]"
                                value="Finance">
                            <label class="form-check-label">Finance</label>
                        </div>

                        <div class="col-md-3 form-check">
                            <input class="form-check-input" type="checkbox" name="department[department_name][]"
                                value="Marketing">
                            <label class="form-check-label">Marketing</label>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="border p-3 mb-4">
                    <legend class="w-auto px-2">Profile Image</legend>

                    <div class="mb-3">
                        <label class="form-label">Upload Profile Picture</label>
                        <input type="file" class="form-control" name="pic" accept="image/*">
                    </div>
                </fieldset>

                <button type="submit" class="btn btn-primary w-100">Add Employee</button>

            </form>
        </div>
        </table>

        <%- include("./../layout/footer") %>

    </body>

</html>