<!doctype html>
<html lang="en">

<%- include("./../layout/header") %>

    <body>
        <div class="container my-5">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4>Employee Details</h4>
                <a href="/employee/" class="btn btn-warning">Back</a>
            </div>

            <div class="card shadow">
                <div class="card-body">

                    <div class="text-center mb-4">
                        <img src="/<%= employee.profile_pic %>" alt="Profile" class="rounded-circle mb-2" width="120"
                            height="120">
                        <h5 class="mt-2">
                            <%= employee.name %>
                        </h5>
                    </div>

                    <table class="table table-bordered">
                        <tbody>

                            <tr>
                                <th width="30%">Phone</th>
                                <td>
                                    <%= employee.contact.phone %>
                                </td>
                            </tr>

                            <tr>
                                <th>Email</th>
                                <td>
                                    <%= employee.contact.email %>
                                </td>
                            </tr>

                            <tr>
                                <th>City</th>
                                <td>
                                    <%= employee.contact.city %>
                                </td>
                            </tr>

                            <tr>
                                <th>Address</th>
                                <td>
                                    <%= employee.contact.address %>
                                </td>
                            </tr>

                            <tr>
                                <th>Full Address</th>
                                <td>
                                    <%= employee.contact.full_address %>
                                </td>
                            </tr>

                            <tr>
                                <th>Department</th>
                                <td>
                                    <% employee.department.department_name.forEach(dep=> { %>
                                        <span class="badge bg-info text-dark me-1">
                                            <%= dep %>
                                        </span>
                                        <% }) %>
                                </td>
                            </tr>

                            <tr>
                                <th>Salary</th>
                                <td><%= employee.salary %>
                                </td>
                            </tr>

                        </tbody>
                    </table>

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <a href="/employee/update/<%= employee._id %>" class="btn btn-primary">
                            <i class="fa-solid fa-person-circle-question"></i>  Edit
                        </a>

                        <a href="/employee/delete/<%= employee._id %>" class="btn btn-danger">
                            <i class="fa-solid fa-person-circle-xmark"></i> Delete
                        </a>
                    </div>

                </div>
            </div>

        </div>

        <%- include("./../layout/footer") %>
    </body>

</html>