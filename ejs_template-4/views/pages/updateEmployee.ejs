<!doctype html>
<html lang="en">

<%- include("./../layout/header") %>

    <body>
        <div class="container my-5">

            <h4 class="text-center mb-4">Update Employee</h4>
            <a href="/employee/" class="btn btn-warning mb-3">Home</a>

            <form action="/employee/updateData/<%=employee._id%>" method="post" enctype="multipart/form-data"
                class="border border-dark p-4 rounded">

                <fieldset class="border p-3 mb-4">
                    <legend class="w-auto px-2">Employee Info</legend>

                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" name="name" value="<%= employee.name %>" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Salary</label>
                        <input type="number" class="form-control" name="salary" value=<%=employee.salary%> required>
                    </div>
                </fieldset>

                <fieldset class="border p-3 mb-4">
                    <legend class="w-auto px-2">Contact Details</legend>

                    <!-- Phone + Email -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Phone</label>
                            <input type="text" class="form-control" value="<%= employee.contact.phone %>"
                                name="contact[phone]" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" value="<%= employee.contact.email %>"
                                name="contact[email]" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">City</label>
                            <input type="text" class="form-control" value="<%= employee.contact.city %>"
                                name="contact[city]" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input type="text" class="form-control" value="<%= employee.contact.address %>"
                            name="contact[address]" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Full Address</label>
                        <textarea class="form-control" name="contact[full_address]" rows="2"
                            required><%= employee.contact.full_address %></textarea>
                    </div>
                </fieldset>

                <fieldset class="border p-3 mb-4">
                    <legend class="w-auto px-2">Department</legend>

                    <% const departments=["HR", "IT" , "Finance" , "Marketing" ]; %>

                        <div class="row">
                            <% departments.forEach(dep=> { %>
                                <div class="col-md-3 form-check">
                                    <input class="form-check-input" type="checkbox" name="department[department_name][]"
                                        value="<%= dep %>" <%=employee.department.department_name.includes(dep)
                                        ? "checked" : "" %>
                                    >
                                    <label class="form-check-label">
                                        <%= dep %>
                                    </label>
                                </div>
                                <% }) %>
                        </div>
                </fieldset>

                <fieldset class="border p-3 mb-4">
                    <legend class="w-auto px-2">Profile Image</legend>

                    <div class="mb-3">
                        <label class="form-label">Current Profile Picture</label><br>
                        <img src="/<%= employee.profile_pic %>" width="100" class="rounded mb-2">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Change Profile Picture</label>
                        <input type="file" class="form-control" name="pic" accept="image/*">
                    </div>

                </fieldset>

                <button type="submit" class="btn btn-primary w-100">Update Employee</button>

            </form>
        </div>
        </table>

        <%- include("./../layout/footer") %>

    </body>

</html>